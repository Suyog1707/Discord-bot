# =============================================================================
# Discord Music Platform — environment variables
# =============================================================================
# Copy to `.env` at the repo root and fill in. `.env` is git-ignored.
# Validate at any time with: pnpm run check:env
#
# Variable names below are the canonical set from docs/ENVIRONMENT_VARIABLES.md.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- WEBSITE -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=k/e9+zU5FEyTnDwpnpK8gERcoVzO+wsG1uN/nZkZPTA=

# --- DISCORD -----------------------------------------------------------------
# OAuth2 application credentials used by the dashboard (Auth.js) — Phase 2.
DISCORD_CLIENT_ID=1534998689704050878
DISCORD_CLIENT_SECRET=H9zNGeWJ88tD3NTmsfq-pA6BV5sLoSr9
# Bot credentials used by apps/bot — Phase 3.
BOT_TOKEN=MTUzNDk5ODY4OTcwNDA1MDg3OA.GJlv_5.F39NAGBo_meGHPoSYHTYstsWcnNZq7D2Rf6-pQ
BOT_CLIENT_ID=1534998689704050878
BOT_PUBLIC_KEY=b0addec899f43c60734f7b90ca0c83216c18a4ac4404b862541613e2b4ea90a2
# Optional: register slash commands instantly in one guild while developing.
BOT_DEV_GUILD_ID=1535256323833466930

# --- DATABASE ----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_music?schema=public

# --- REDIS -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- LAVALINK ----------------------------------------------------------------
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# --- SPOTIFY (optional) ------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard, add
# <NEXTAUTH_URL>/api/spotify/callback as a Redirect URI.
# Without these, Spotify linking/import and Spotify URL playback stay disabled.
SPOTIFY_CLIENT_ID=790283934de741f487c599dfa266a251
SPOTIFY_CLIENT_SECRET=5d5d58664dce4e00afcd9a0ce4e41b07

# --- BOT EXTRAS (optional) ---------------------------------------------------
# Public dashboard URL used for links in bot replies (/spotify connect, the
# controller's Dashboard button). Usually the same as NEXTAUTH_URL.
DASHBOARD_URL=
# NEXTAUTH_SECRET is shared with the bot process automatically when both apps
# read the same .env — it lets `/spotify playlists` decrypt dashboard-stored
# tokens. No extra variable needed here.
