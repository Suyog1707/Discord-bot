# Copy to ~/.config/discord-music/backup.env (mode 0600) on the PC.
# Adjust the username/path; this file is a template, not a working backup.
MUSIC_BACKUP_DIR=/home/YOUR_USER/Backups/discord-music
# While the PC hosts PostgreSQL:
MUSIC_BACKUP_SOURCE=local
# After the VPS cutover, switch to remote and set the SSH target/port:
# MUSIC_BACKUP_SOURCE=remote
# MUSIC_BACKUP_SSH_TARGET=YOUR_VPS_USER@YOUR_VPS_TAILSCALE_HOST
# MUSIC_BACKUP_SSH_PORT=22
MUSIC_BACKUP_MAX_AGE_HOURS=36
MUSIC_BACKUP_RETENTION_DAYS=30
