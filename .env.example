# =============================================================================
# Discord Music Platform — environment variables
# =============================================================================
# Copy to `.env` at the repo root and fill in. `.env` is git-ignored.
# Validate at any time with: pnpm run check:env
#
# Variable names below are the canonical set from docs/ENVIRONMENT_VARIABLES.md.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- WEBSITE -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000
# This marks only the PC/VPS backend (and host-side dev) as allowed to serve
# without Vercel forwarding. Never add it to Vercel.
WEB_BACKEND_LOCAL=true
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Vercel injects this into requests sent through Funnel. Generate separately
# with `openssl rand -hex 32`; never put it in a NEXT_PUBLIC_ variable.
ORIGIN_SECRET=
# Set these only in Vercel Production after the local Funnel URL is ready.
# BACKEND_PROXY_ENABLED=true
# BACKEND_PROXY_URL=https://your-device.your-tailnet.ts.net
# ORIGIN_SECRET=<same secret as the local web-gateway>

# --- DISCORD -----------------------------------------------------------------
# OAuth2 application credentials used by the dashboard (Auth.js) — Phase 2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot credentials used by apps/bot — Phase 3.
BOT_TOKEN=
BOT_CLIENT_ID=
BOT_PUBLIC_KEY=
# Optional: register slash commands instantly in one guild while developing.
BOT_DEV_GUILD_ID=
# --- THE PLAYER POOL ---------------------------------------------------------
# One server can play in several voice channels at once. Discord allows one
# voice connection per guild per TOKEN, so every simultaneous room needs its own
# Discord application — and, in production, its own container.
#
# BOT_TOKEN / BOT_CLIENT_ID above are the primary: the only bot with slash
# commands, and a player in its own right, so a server that only ever needs one
# room still invites one bot. Each pair below is a headless player.
#
# Fill in as many as you want rooms. `docker/docker-compose.yml` has services
# for players 2-7; an eighth is a copy of one of those blocks plus a pair here.
# Nothing in the code knows the count — each container registers itself on
# startup — so leaving these blank simply means single-room behaviour.
#
# Create each one at https://discord.com/developers/applications: a new
# application, Bot tab for the token, "Public Bot" off, no privileged intents.
# BOT_PLAYER_2_TOKEN=
# BOT_PLAYER_2_CLIENT_ID=
# BOT_PLAYER_3_TOKEN=
# BOT_PLAYER_3_CLIENT_ID=
# BOT_PLAYER_4_TOKEN=
# BOT_PLAYER_4_CLIENT_ID=
# BOT_PLAYER_5_TOKEN=
# BOT_PLAYER_5_CLIENT_ID=
# BOT_PLAYER_6_TOKEN=
# BOT_PLAYER_6_CLIENT_ID=
# BOT_PLAYER_7_TOKEN=
# BOT_PLAYER_7_CLIENT_ID=
#
# Which of those containers docker actually starts. Each player service sits
# behind a compose profile, so by default only the primary runs — the
# single-room setup — and you turn players on as you create their applications:
#
#   COMPOSE_PROFILES=players            # all of them
#   COMPOSE_PROFILES=player-2,player-3  # just these two
#
# Read by `docker compose` itself, so it belongs in .env rather than in the
# compose file, and a player you have not created yet is never started.
COMPOSE_PROFILES=

# --- ONE CONTAINER'S OWN IDENTITY --------------------------------------------
# Each of these describes the single bot running in THIS process. In production
# compose sets them per service; for `pnpm dev` the defaults below run the
# primary alone, which is the whole bot minus the extra rooms.
#
# primary | player — primary owns the slash commands, the guards and the
# dashboard command bus. A player only holds a channel and answers intents.
BOT_ROLE=primary
# Short name for logs, the roster and the invite prompt.
BOT_LABEL=main
# Port for the container's private HTTP surface: health checks, and the calls
# containers make to each other. Bound inside the container and never published,
# so every one of them can share the same number.
BOT_INTERNAL_PORT=8080
# How long this bot may sit with its gateway disconnected before it quits and
# lets `restart: always` give it a fresh connection. Docker restarts containers
# that crash, not ones that are alive and wedged. Generous on purpose —
# discord.js reconnects on its own, and a shorter threshold would restart a bot
# that was about to recover. 0 disables it.
BOT_UNHEALTHY_EXIT_AFTER_MS=120000
# How often that check runs.
BOT_HEALTH_CHECK_MS=15000
# How often this container republishes its presence entry: which players are
# running, and where to reach them. The entry expires on its own, so a container
# that is killed leaves the fleet without anybody having to clean up after it.
BOT_HEARTBEAT_MS=20000
# How long a room must sit empty before another channel may take its player.
# Long enough to survive everyone moving between channels together, short enough
# that a genuinely abandoned room is not held for a noticeable time.
ROOM_RECLAIM_GRACE_MS=60000

# --- DATABASE ----------------------------------------------------------------
# Local Docker database. Compose containers build their own private URLs from
# these values; the URLs below are for host-side pnpm commands only.
# Generate a URL-safe password with: openssl rand -hex 32
POSTGRES_DB=discord_music
POSTGRES_USER=discord_music
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Substitute the POSTGRES_* values above. Do not add these to Vercel.
DATABASE_URL=postgresql://discord_music:<POSTGRES_PASSWORD>@127.0.0.1:5432/discord_music
DIRECT_URL=postgresql://discord_music:<POSTGRES_PASSWORD>@127.0.0.1:5432/discord_music

# --- REDIS -------------------------------------------------------------------
# Local Docker Redis; the bots and web backend use the private Compose address.
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379

# --- AI + RECOMMENDATIONS ------------------------------------------------------
# All optional. The stack degrades one service at a time: without GROQ_API_KEY
# natural-language requests fall back to a heuristic parser, without
# LASTFM_API_KEY candidates come from listening history and search instead of the
# similarity graph. Playback never depends on any of these.
#
# Groq — https://console.groq.com/keys (free tier is enough for intent parsing).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high, or empty for a model with no reasoning mode
# (Groq 400s on the parameter rather than ignoring it).
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_MS=6000
# Last.fm — https://www.last.fm/api/account/create
LASTFM_API_KEY=
# MusicBrainz needs no key; this is a kill switch for its 1 req/sec limit.
MUSICBRAINZ_ENABLED=true
# Candidates generated per pass, before ranking trims to what is actually queued.
RECOMMENDATION_POOL_SIZE=400
RECOMMENDATION_CONCURRENCY=8
AUTOPLAY_PREFETCH_SIZE=2
# Autoplay cadence: how many familiar songs (your library, playlists, history)
# play between discoveries. A range, not a fixed beat — the planner uses the
# high end when your own pool is deep and the low end when it is thin.
AUTOPLAY_FAMILIAR_RUN_MIN=2
AUTOPLAY_FAMILIAR_RUN_MAX=3
# Set to false for a pure jukebox: autoplay then only replays songs you know.
AUTOPLAY_DISCOVERY_ENABLED=true
# Let a listener's linked Spotify library steer autoplay: their playlists and
# Liked Songs join the familiar pool, their artists seed discovery. Applies to
# whoever is in the voice channel, and only if they left the dashboard opt-in
# on. Reads are cached and never block a queue refill.
SPOTIFY_TASTE_ENABLED=true
# Tracks read per listener before their library is truncated.
SPOTIFY_TASTE_MAX_TRACKS=200
# Queue refill: when the upcoming count drops to LOW_WATER, autoplay fills it
# back up to TARGET — before the queue ever drains.
AUTOPLAY_LOW_WATER_MARK=2
AUTOPLAY_TARGET_QUEUE_SIZE=4
# How long a song rests before autoplay may play it again (halved, never below
# 30 minutes, only when nothing else is eligible).
AUTOPLAY_REPEAT_COOLDOWN_MINUTES=180

# --- LAVALINK ----------------------------------------------------------------
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false

# --- SPOTIFY (optional) ------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard, add
# <NEXTAUTH_URL>/api/spotify/callback as a Redirect URI.
# Without these, Spotify linking/import and Spotify URL playback stay disabled.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Runtime `/play` playlist safety cap (the guild queue itself holds at most 1000).
SPOTIFY_PLAYLIST_MAX_TRACKS=1000
# Concurrent Lavalink searches while expanding Spotify albums/playlists.
SPOTIFY_RESOLVE_CONCURRENCY=8

# --- TRACK RESOLUTION (optional) ---------------------------------------------
# The metadata layer (Spotify / Apple Music / Deezer) decides WHAT song was
# asked for; the playback layer (SoundCloud / YouTube / HTTP) finds an upload
# that IS it. These tune the second half. See apps/bot/src/music/match-config.ts
# for what every weight does; only the knobs worth changing in production are
# exposed here.
#
# Playback provider priority. SoundCloud first by design: its catalogue is only
# music, so its worst wrong answer is a bootleg remix, whereas YouTube's index
# also holds the film the song is from, its trailer, and three reactions to it.
# Accepts: soundcloud,youtube | youtube,soundcloud | soundcloud | youtube
PLAYBACK_PROVIDER_ORDER=soundcloud,youtube
# How far a candidate's runtime may sit from the canonical runtime and still
# count as a match. The +/-10-15s band covers fades, silent tails and the
# half-second disagreements between catalogues.
MATCH_DURATION_TOLERANCE_MS=12000
# Minimum score a candidate must reach before it is played. Nothing below the
# threshold is ever played — an honest "no reliable match" beats the wrong song.
#
# SoundCloud's is the higher of the two, which looks backwards until you notice
# what the fallback is: whatever SoundCloud refuses gets asked of YouTube, where
# the official Topic and VEVO uploads live. A demanding primary therefore costs
# a little latency, not coverage. YouTube's is lower because nothing follows it
# — below that, the track simply does not play.
MATCH_SOUNDCLOUD_MIN_SCORE=70
MATCH_YOUTUBE_MIN_SCORE=55
# Extra uploader-name tokens that mark a rights-holder, comma-separated. The
# built-in list is generic ("records", "recordings", "label"), not a roster of
# company names — this is where you add the labels your listeners care about.
# e.g. MATCH_OFFICIAL_CHANNELS=T-Series,Saregama,Sony Music India
MATCH_OFFICIAL_CHANNELS=

# --- BOT EXTRAS (optional) ---------------------------------------------------
# Public dashboard URL used for links in bot replies (/spotify connect, the
# controller's Dashboard button). Usually the same as NEXTAUTH_URL.
DASHBOARD_URL=
# NEXTAUTH_SECRET is shared with the bot process automatically when both apps
# read the same .env — it lets `/spotify playlists` decrypt dashboard-stored
# tokens. No extra variable needed here.

# --- LAVALINK YOUTUBE (optional) ---------------------------------------------
# A proof-of-origin token. Without one YouTube decides this host is a bot and
# refuses playback on every client at once — "This video requires login",
# "Sign in to confirm you're not a bot", 403, or a WEB response carrying no
# audio formats at all. Mint a pair with `pnpm run pot:refresh` (and
# `pnpm run pot:refresh -- --clear` to blank them again).
#
# A token lasts about six hours and is bound to the egress IP that minted it, so
# it expires on a timer and again on any change of host or network. Leaving both
# empty is a supported state, not a broken one: playback works without a token
# whenever YouTube is not currently flagging this host.
YT_PO_TOKEN=
YT_VISITOR_DATA=
#
# A poToken only reaches the WEB and WEBEMBEDDED clients. Some videos —
# label-owned music especially — are answered with "This video
# requires login" on every anonymous YouTube client, and no amount of client
# configuration changes that. OAuth signs Lavalink in so those tracks play.
# Use a burner Google account, never your primary: upstream warns the account
# can be terminated. Set this to true, run `pnpm docker:logs`, open the
# https://www.google.com/device code it prints, then paste the refresh token
# Lavalink logs afterwards into YT_OAUTH_REFRESH_TOKEN so restarts skip the flow.
YT_OAUTH_ENABLED=false
YT_OAUTH_REFRESH_TOKEN=
