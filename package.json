{
  "name": "discord-music-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-grade Discord music platform: Next.js dashboard, Discord bot, Lavalink playback.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:system": "bash scripts/test-system.sh",
    "test:system:integration": "bash scripts/test-system.sh --integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:env": "node scripts/check-env.mjs",
    "db:generate": "pnpm --filter @discord-music/database run generate",
    "db:migrate": "pnpm --filter @discord-music/database run migrate",
    "db:deploy": "pnpm --filter @discord-music/database run deploy",
    "db:push": "pnpm --filter @discord-music/database run push",
    "db:pull": "pnpm --filter @discord-music/database run pull",
    "db:studio": "pnpm --filter @discord-music/database run studio",
    "db:seed": "pnpm --filter @discord-music/database run seed",
    "pot:refresh": "node scripts/refresh-pot.mjs",
    "docker:up": "DOCKER_CONTEXT=${DOCKER_CONTEXT:-default} docker compose --env-file .env -f docker/docker-compose.yml up -d --build",
    "docker:down": "DOCKER_CONTEXT=${DOCKER_CONTEXT:-default} docker compose --env-file .env -f docker/docker-compose.yml down",
    "docker:logs": "DOCKER_CONTEXT=${DOCKER_CONTEXT:-default} docker compose --env-file .env -f docker/docker-compose.yml logs -f",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky",
    "check:env:prod": "node scripts/check-env.mjs --production"
  },
  "devDependencies": {
    "@discord-music/shared": "workspace:*",
    "@eslint/js": "^9.33.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
