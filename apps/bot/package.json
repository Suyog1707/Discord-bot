{
  "name": "@discord-music/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot: slash commands, events, voice handling and Lavalink playback.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "commands:deploy": "tsx --env-file-if-exists=../../.env src/scripts/deploy-commands.ts",
    "commands:clear": "tsx --env-file-if-exists=../../.env src/scripts/deploy-commands.ts --clear",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@discord-music/database": "workspace:*",
    "@discord-music/shared": "workspace:*",
    "discord.js": "^14.22.1",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "shoukaku": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "pino-pretty": "^13.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
